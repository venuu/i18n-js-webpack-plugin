{
  "name": "@venuu/i18n-js-webpack-plugin",
  "version": "3.0.0",
  "description": "webpack companion plugin for i18n-js to include only used translations",
  "main": "dist/index.js",
  "homepage": "https://github.com/venuu/i18n-js-webpack-plugin",
  "bugs": "https://github.com/venuu/i18n-js-webpack-plugin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venuu/i18n-js-webpack-plugin.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "build-example": "npm run build && webpack --config ./example/webpack.config.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "webpack",
    "i18n",
    "i18n-js",
    "rails",
    "ruby-on-rails"
  ],
  "author": "Vesa Laakso <laakso.vesa@gmail.com>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/webpack-node-externals": "^3.0.4",
    "i18n-js": "^3.9.2",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "types": "dist/index.d.ts"
}
