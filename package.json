{
  "name": "@venuu/i18n-js-webpack-plugin",
  "version": "3.0.0",
  "description": "webpack companion plugin for i18n-js to include only used translations",
  "main": "index.js",
  "homepage": "https://github.com/venuu/i18n-js-webpack-plugin",
  "bugs": "https://github.com/venuu/i18n-js-webpack-plugin/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/venuu/i18n-js-webpack-plugin.git"
  },
  "scripts": {
    "build-example": "webpack --config ./example/webpack.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest"
  },
  "keywords": [
    "webpack",
    "i18n",
    "i18n-js",
    "rails",
    "ruby-on-rails"
  ],
  "author": "Vesa Laakso <laakso.vesa@gmail.com>",
  "license": "MIT",
  "files": [
    "index.js",
    "lib"
  ],
  "devDependencies": {
    "i18n-js": "^3.9.2",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
